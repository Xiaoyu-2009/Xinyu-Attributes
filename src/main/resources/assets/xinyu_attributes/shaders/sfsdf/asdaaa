vec3 SoftClip(vec3 x) // added, adapted from: https://www.shadertoy.com/view/wdtfRS
{
    return (1.0 + x - sqrt(1.0 - 1.99*x + x*x)) / (1.995);
}

float sRGBencode(float C_linear) { return C_linear > 0.0031308 ? (1.055 * pow(C_linear, 1./2.4) - 0.055) : (12.92 * C_linear); }
vec3 sRGBencode(vec3 C_linear) { C_linear = clamp(C_linear, 0., 1.); return vec3(sRGBencode(C_linear.x), sRGBencode(C_linear.y), sRGBencode(C_linear.z)); }


// Based on http://www.oscars.org/science-technology/sci-tech-projects/aces
vec3 aces_tonemap(vec3 color){	
	mat3 m1 = mat3(
        0.59719, 0.07600, 0.02840,
        0.35458, 0.90834, 0.13383,
        0.04823, 0.01566, 0.83777
	);
	mat3 m2 = mat3(
        1.60475, -0.10208, -0.00327,
        -0.53108,  1.10813, -0.07276,
        -0.07367, -0.00605,  1.07602
	);
	vec3 v = m1 * color;    
	vec3 a = v * (v + 0.0245786) - 0.000090537;
	vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
        
	return m2 * (a / b); // changed
}

void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
	vec2 position = (fragCoord/iResolution.xy)* 2.0 - 1.0;
    //position.x += iTime * 0.2;
    position.x += 12. * 0.2;

	vec3 color = pow(
        sin(position.x * 4.0 + vec3(0.0, 1.0, 2.0) * 3.1415 * 2.0 / 3.0) * 0.5 + 0.5, vec3(2.0)) * (exp(abs(position.y) * 4.0) - 1.0);

    
    if(any(lessThan(color, vec3(0))))
    {
        fragColor = vec4(1,0,1, 1);
        return;
    }
	if(position.y < 0.0)
    {
    
        #if 1
		color = aces_tonemap(color);   
        #elif 0
        color = 1.-exp(-color);
        #else
        float exposure = 0.;
        color = flim_transform(color, exposure, false);
        #endif
        
        // added
        
        if(length(iMouse) > 10. ? (iMouse.x > fragCoord.x) : (sin(iTime)*.5+.5) > fragCoord.x/iResolution.x)
        {
            color = SoftClip(color);
        }
        else
        {
            if(int(iTime) % 10 > 5) // toggle between showing region in gray, and just showing output colors every 5 seconds.
                color = mix(color, vec3(0), float(any(greaterThan(color, vec3(1)))) * 0.2);
            
            color = clamp(color, 0., 1.);
        }
        
        
	}
    //color.rb *= 0.; // inspect green channel only
    
    if(int(iTime) % 2 == 0) // added: Switches between pow 1/2.2 and sRGB each second.
    {
        color = sRGBencode(color);
    } else {
        color = pow(color, vec3(1.0 / 2.2));
    }
    
	fragColor = vec4(color,1.0); // changed
}