#define R(p,a,r)mix(a*dot(p,a),p,cos(r))+sin(r)*cross(p,a)
#define H(h)(cos((h)*6.3+vec3(0,23,21))*.5+.5)
void mainImage(out vec4 O, vec2 C)
{
    O=vec4(0);
    vec3 p,r=iResolution,
    d=normalize(vec3((C-.5*r.xy)/r.y,1.2));
 
    for(
        float i=0.,g=0.,e,s;
        ++i<99.;
        O.rgb+=mix(r/r,H(log(s)),1.2)*.08*exp(-i*i*e))
    {
        p=g*d;
           
        p.z-=1.0;
       float a1=1.5;
       float a2=iTime*0.15;
        s=2.;
            p.xz*=mat2(cos(a1),sin(a1),-sin(a1),cos(a1));
            p.xy*=mat2(cos(a2),sin(a2),-sin(a2),cos(a2));
        for(int j=0;j++<10;)
       
            p=abs(p),
            p=p.x<p.y?p.zxy:p.zyx,
              p=p.y<p.z?p.zxy:p.zyx,
           
            s*=e=1.5/min(dot(p,p),1.3),
            p=p*e-vec3(12,3,3);
            
        g+=e=length(p.yz)/s;
  
    }
    O=pow(O,vec4(5));
 }